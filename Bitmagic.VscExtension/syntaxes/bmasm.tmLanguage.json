{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "BitMagic X16 Asm",
	"patterns": [
		{ "include" : "#asm-blockstarts" },
		{ "include" : "#asm-blockends" },
		{ "include" : "#asm-strings" },
		{ "include" : "#asm-charliteral" },
		{ "include" : "#asm-literals" },
		{ "include" : "#asm-comments" },
		{ "include" : "#asm-operators" },
		{ "include" : "#asm-opcodes" },
		{ "include" : "#asm-labels" },
		{ "include" : "#asm-pseudofunctions" },
		{ "include" : "#asm-variabledefinition" },
		{ "include" : "#magic-import" },
		{ "include" : "#magic-include" },
		{ "include" : "#magic-library"},
		{ "include" : "#magic-file" },
		{ "include" : "#magic-section" },
		{ "include" : "#magic-place" },
		{ "include" : "#magic-nuget" },
		{ "include" : "#magic-reference" },
		{ "include" : "source.csasm" }
	],
	"repository": {
		"asm-comments": {
			"patterns": [
				{
					"name": "comment.line.bmasm",
					"match": ";.*$"
				},
				{
					"comment": "// is also accepted as a line comment on a directive line",
					"name": "comment.line.bmasm",
					"match": "//.*$"
				},
				{
					"name": "comment.block.bmasm",
					"begin": "/\\*",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.bmasm"
						}
					},
					"end": "\\*/",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.comment.bmasm"
						}
					}
				}
			]
		},
		"asm-literals": {
			"patterns": [
				{
					"name": "constant.numeric.binary.bmasm",
					"match": "(%[01_]+\\b)|(0b[01_]+\\b)"
				},
				{
					"name": "constant.numeric.hex.bmasm",
					"match": "(\\$[0-9A-Fa-f_]+\\b)|(0x[0-9A-Fa-f_]+\\b)"
				},
				{
					"name": "constant.numeric.decimal.bmasm",
					"match": "\\b[0-9_]+\\b"
				},
				{
					"name": "constant.language.unnamed-label.bmasm",
					"match": ":-+|:\\++"
				}
			]
		},
		"asm-strings": {
			"name": "string.quoted.double.bmasm",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.bmasm",
					"match": "\\\\."
				}
			]
		},
		"asm-charliteral": {
			"patterns": [
				{
					"comment": "'A' as an expression evaluates to its character code, see Compiler/Expressions.md",
					"name": "string.quoted.single.bmasm",
					"match": "'\\\\?.'"
				}
			]
		},
		"asm-operators": {
			"patterns": [
				{
					"name": "keyword.operators.immediate.bmasm",
					"match": "[#|^|<|>]"
				},
				{
					"name": "keyword.operators.misc.bmasm",
					"match": "=|<>|\\+|-|\\*|/|\\&|~|\\||<<|>>|\\&\\&|\\|\\||!|<|>|<=|>="
				},
				{
					"name": "keyword.operators.indirect.bmasm",
					"match" : "\\(|\\)"
				}
			]
		},
		"asm-opcodes": {
			"patterns": [
				{
					"comment": "6502 Opcodes",
					"name": "entity.name.function.bmasm.6502",
					"match": "\\b(?i:adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|pla|plp|rol|ror|rti|rts|sbc|sec|sed|sei|sta|stx|sty|stp|tax|tay|tsx|txa|txs|tya)\\b"
				},
				{
					"comment": "65C02 Opcodes",
					"name": "entity.name.function.bmasm.65c02",
					"match": "\\b(?i:bra|phx|phy|plx|ply|stz|trb|tsb|bbr0|bbr1|bbr2|bbr3|bbr4|bbr5|bbr6|bbr7|bbs0|bbs1|bbs2|bbs3|bbs4|bbs5|bbs6|bbs7|rmb0|rmb1|rmb2|rmb3|rmb4|rmb5|rmb6|rmb7|smb0|smb1|smb2|smb3|smb4|smb5|smb6|smb7|wai|ldd)\\b"
				}
			]
		},
		"asm-pseudofunctions": {
			"patterns": [
				{
					"comment": "the name being defined, after any public / private, is taken here so the value after it can't be read as a C# field declaration ('.export line_count lines ; ...')",
					"match": "(\\.(?i:const|export))(?:\\s+(public|private)\\b)?(?:\\s+([_[:alpha:]][_[:alnum:]]*)\\b)?",
					"captures": {
						"1": {
							"name": "entity.name.function.pseudofunction.bmasm"
						},
						"2": {
							"name": "storage.modifier.bmasm"
						},
						"3": {
							"name": "entity.name.variable.bmasm"
						}
					}
				},
				{
					"name": "entity.name.function.pseudofunction.bmasm",
					"match": "\\.(?i:byte|word|const|export|pad|align|importfile|org|cpu|machine|exception|breakpoint|nostop|stop|debugload)\\b"
				}
			]
		},
		"asm-variabledefinition": {
			"patterns": [
				{
					"match": "(\\.var|\\.padvar|\\.constvar|\\.debugalias)\\s+(?:(public|private)\\s+)?(?i:(byte|sbyte|short|ushort|int|uint|long|ulong|string|proc))(?:\\[\\d+\\])?\\s+(?i:(ptr))?",
					"captures": {
						"1": {
							"name": "entity.name.function.pseudofunction.bmasm"
						},
						"2": {
							"name": "storage.modifier.bmasm"
						},
						"3": {
							"name": "keyword.type.bmasm"
						},
						"4": {
							"name": "keyword.type.bmasm"
						}
					}
				}
			]
		},
		"asm-blockstarts": {
			"patterns": [
				{
					"comment": ".proc public / .proc private, and .scope public / .scope private",
					"match": "([\\.\\!](?i:proc|scope))\\s+(public|private)\\b",
					"captures": {
						"1": {
							"name": "keyword.control.block.bmasm"
						},
						"2": {
							"name": "storage.modifier.bmasm"
						}
					}
				},
				{
					"name": "keyword.control.block.bmasm",
					"contentName": "entity.name.function.bmasm",
					"match": "[\\.\\!](?i:proc|scope|segment)\\b"
				}
			]
		},
		"asm-blockends": {
			"patterns": [
				{
					"name": "keyword.control.block.bmasm",
					"match": "\\.(?i:endproc|endscope|endsegment)\\b"
				}
			]
		},
		"asm-labels": {
			"patterns": [
				{
					"name": "entity.name.label.bmasm",
					"match": "^\\.\\w+:"
				}
			]
		},
		"magic-import" : {
			"patterns" : [
				{
					"match" : "^\\s*(import)\\s+(\\w+)\\s*=\\s*(\"[\\w.\\\\:\\/-]+\")",
					"captures" : {
						"1": {
							"name" : "keyword.other.import"
						},
						"2" : {
							"name" : "entity.name.class"
						},
						"3" :{
							"name" : "string.quote"
						}
					}
				}
			]
		},
		"magic-include" : {
			"patterns" : [
				{
					"match" : "^\\s*(include)\\s+(\"[\\w.\\\\:\\/-]+\")",
					"captures" : {
						"1": {
							"name" : "keyword.other.include"
						},
						"2" : {
							"name" : "entity.name.class"
						},
						"3" :{
							"name" : "string.include"
						}
					}
				}
			]
		},
		"magic-file" : {
			"patterns" : [
				{
					"comment" : "file <kind> [arguments]: the file is handled by the view <kind>.bmasm. Not C#'s 'file class X'.",
					"match" : "^\\s*(file)\\s+(?!(?:class|struct|record|interface|enum|delegate|static|sealed|abstract|partial|readonly|unsafe|ref)\\b)([A-Za-z_][\\w-]*)(?:\\s+([^;]*?))?\\s*(?=;|$)",
					"captures" : {
						"1" : { "name" : "keyword.other.file" },
						"2" : { "name" : "entity.name.class" },
						"3" : { "name" : "entity.name.section.bmasm" }
					}
				}
			]
		},
		"magic-section" : {
			"patterns" : [
				{
					"comment" : "section <name>, in a 'file library' file",
					"match" : "^\\s*(section)\\s+([A-Za-z_]\\w*)\\b",
					"captures" : {
						"1" : { "name" : "keyword.other.section" },
						"2" : { "name" : "entity.name.section.bmasm" }
					}
				}
			]
		},
		"magic-place" : {
			"patterns" : [
				{
					"comment" : "place <section> or place <alias>.<section>",
					"match" : "^\\s*(place)\\s+(?:([A-Za-z_]\\w*)(\\.))?([A-Za-z_]\\w*)\\b",
					"captures" : {
						"1" : { "name" : "keyword.other.place" },
						"2" : { "name" : "entity.name.class" },
						"3" : { "name" : "punctuation.accessor.bmasm" },
						"4" : { "name" : "entity.name.section.bmasm" }
					}
				}
			]
		},
		"magic-library" : {
			"patterns" : [
				{
					"match" : "^\\s*(library)\\s+([\\w.-_]+)",
					"captures" : {
						"1" : {
							"name" : "keyword.other.library"
						},
						"2" : {
							"name" : "entity.name.class"
						}
					}
				}
			]
		},
		"magic-nuget" : {
			"patterns" : [
				{
					"match" : "^\\s*(nuget)\\s+(\"?[\\w.-_]+\"?)(\\s+(\"?[\\w.-_]+\"?))?",
					"captures" : {
						"1" : {
							"name" : "keyword.other.nuget"
						},
						"2" : {
							"name" : "string.quoted"
						},
						"3" : {
							"name" : "string.quoted"
						}
					}
				}
			]
		},
		"magic-reference" : {
			"patterns" : [
				{
					"match" : "^\\s*(reference)\\s+(\"?[\\w.-_]+\"?)(\\s+(\"?[\\w.-_]+\"?))?",
					"captures" : {
						"1" : {
							"name" : "keyword.other.reference"
						},
						"2" : {
							"name" : "string.quoted"
						},
						"3" : {
							"name" : "string.quoted"
						}
					}
				}
			]
		}
	},
	"scopeName": "source.bmasm"
}
