{
    "version": "2.0.0",
    "tasks": [
        {
            // "process" runs `node` directly on the host OS with no shell involved, so it
            // can't be routed through `wsl.exe -e node` by the terminal profile settings.
            "type": "process",
            "label": "buildExtension",
            "command": "node",
            "args": ["./esbuild.js"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
